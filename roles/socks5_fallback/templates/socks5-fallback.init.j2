#!/bin/sh /etc/rc.common

START=95
STOP=15
USE_PROCD=1

NAME=socks5-fallback
PROG=/usr/local/bin/socks5-fallback.sh

start_service() {
    procd_open_instance
    procd_set_param command "$PROG"
    procd_set_param respawn
    procd_close_instance
}

stop_service() {
    # Fail-open: при остановке сервиса оставляем DIRECT-режим (цепочка пустая).
    # Раньше здесь включался PROXY "for safety" — это чёрная дыра: если SOCKS5
    # мёртв, а сервис остановлен (или упал), весь TCP-трафик уходил в
    # нерабочий прокси без какой-либо health-check логики.
    logger -t socks5-fallback "Stopping service, resetting to DIRECT mode in nftables"
    nft flush chain inet fw4 tproxy_dispatch 2>/dev/null
}
